{
  "uid": "clinsense-live",
  "title": "ClinSense Fisio Center — Telemonitoramento IoT (40 Pulseiras)",
  "tags": ["clinsense", "iot", "telemonitoramento"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Pacientes Monitorados",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "clinsense-infinity" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://grafana-api:8000/api/kpis",
          "url_options": { "method": "GET" },
          "columns": [{ "selector": "pacientes_ativos", "text": "Pacientes", "type": "number" }]
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "id": 2,
      "title": "Alertas Críticos (BPM > 120 / SpO2 < 92%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "clinsense-infinity" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://grafana-api:8000/api/kpis",
          "url_options": { "method": "GET" },
          "columns": [{ "selector": "alertas_criticos", "text": "Alertas", "type": "number" }]
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 3,
      "title": "BPM Médio da Frota",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "clinsense-infinity" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://grafana-api:8000/api/kpis",
          "url_options": { "method": "GET" },
          "columns": [{ "selector": "bpm_medio", "text": "BPM Médio", "type": "number" }]
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bpm", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 100 }, { "color": "red", "value": 120 }] } } }
    },
    {
      "id": 4,
      "title": "SpO2 Médio da Frota (%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "clinsense-infinity" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://grafana-api:8000/api/kpis",
          "url_options": { "method": "GET" },
          "columns": [{ "selector": "spo2_medio", "text": "SpO2 Médio", "type": "number" }]
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 92 }] } } }
    },
    {
      "id": 5,
      "title": "Leituras Camada Quente (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "clinsense-infinity" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://grafana-api:8000/api/kpis",
          "url_options": { "method": "GET" },
          "columns": [{ "selector": "leituras_quentes", "text": "Leituras", "type": "number" }]
        }
      ]
    },
    {
      "id": 6,
      "title": "Alertas Clínicos Recentes (DynamoDB: clinsense_alertas)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "clinsense-infinity" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://grafana-api:8000/api/alerts",
          "url_options": { "method": "GET" },
          "columns": [
            { "selector": "timestamp", "text": "Timestamp", "type": "string" },
            { "selector": "patient_id", "text": "Paciente", "type": "string" },
            { "selector": "bpm", "text": "BPM", "type": "number" },
            { "selector": "spo2", "text": "SpO2 (%)", "type": "number" },
            { "selector": "reason", "text": "Motivo Clínico", "type": "string" }
          ]
        }
      ]
    },
    {
      "id": 7,
      "title": "Auditoria Data Lake S3 via DuckDB (Top 15 BPM Médio)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "clinsense-infinity" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://grafana-api:8000/api/s3-summary",
          "url_options": { "method": "GET" },
          "columns": [
            { "selector": "patient_id", "text": "Paciente", "type": "string" },
            { "selector": "total_leituras", "text": "Leituras S3", "type": "number" },
            { "selector": "bpm_medio", "text": "BPM Médio", "type": "number" },
            { "selector": "spo2_medio", "text": "SpO2 Médio", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 8,
      "title": "Últimas Leituras de Telemetria (DynamoDB: clinsense_quente)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "clinsense-infinity" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://grafana-api:8000/api/telemetry",
          "url_options": { "method": "GET" },
          "columns": [
            { "selector": "timestamp", "text": "Timestamp", "type": "string" },
            { "selector": "patient_id", "text": "Paciente", "type": "string" },
            { "selector": "device_id", "text": "Pulseira", "type": "string" },
            { "selector": "bpm", "text": "BPM", "type": "number" },
            { "selector": "spo2", "text": "SpO2 (%)", "type": "number" }
          ]
        }
      ]
    }
  ]
}